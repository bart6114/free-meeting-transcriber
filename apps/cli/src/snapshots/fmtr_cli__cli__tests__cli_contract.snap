---
source: apps/cli/src/cli.rs
expression: canonicalize_json(contract)
---
{
  "about": "Query and edit local Free Meeting Transcriber meeting data",
  "global_options": [
    {
      "flags": "--base",
      "is_flag": false,
      "required": false,
      "value_name": "DIR"
    },
    {
      "flags": "--vault-path",
      "is_flag": false,
      "required": false,
      "value_name": "DIR"
    },
    {
      "flags": "--json",
      "is_flag": true,
      "required": false
    }
  ],
  "name": "fmtr",
  "options": [
    {
      "flags": "-h, --help",
      "help": "Print help",
      "is_flag": false,
      "required": false
    },
    {
      "flags": "-V, --version",
      "help": "Print version",
      "is_flag": false,
      "required": false
    }
  ],
  "subcommands": [
    {
      "about": "Check the local CLI and vault access without changing data",
      "name": "fmtr doctor",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "fmtr doctor [-h]"
    },
    {
      "about": "Browse, create, edit, and export meetings",
      "name": "fmtr meetings",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "List meetings, optionally filtered by text",
          "name": "fmtr meetings list",
          "options": [
            {
              "flags": "-q, --query",
              "is_flag": false,
              "required": false,
              "value_name": "QUERY"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum results (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of results to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings list [-q] [--limit] [--offset] [-h]"
        },
        {
          "about": "Search across meeting titles, notes, summaries, and transcripts",
          "arguments": [
            {
              "help": "Case-insensitive terms that must all occur",
              "name": "QUERY",
              "required": false
            }
          ],
          "name": "fmtr meetings search",
          "options": [
            {
              "flags": "--speaker",
              "help": "Person id or name substring; limits hits to meetings where that person spoke",
              "is_flag": false,
              "required": false,
              "value_name": "SPEAKER"
            },
            {
              "flags": "--kind",
              "help": "Restrict to a source; repeatable, defaults to all",
              "is_flag": false,
              "possible_values": [
                "title",
                "note",
                "summary",
                "transcript"
              ],
              "required": false,
              "value_name": "KIND"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum hits (1-50)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of hits to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings search [--speaker] [--kind] [--limit] [--offset] [-h] [query]"
        },
        {
          "about": "Show meeting metadata, notes, summaries, and action items",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "fmtr meetings get",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings get [-h] <id>"
        },
        {
          "about": "Create a meeting note and print its id",
          "name": "fmtr meetings new",
          "options": [
            {
              "flags": "--title",
              "help": "Title for the new meeting",
              "is_flag": false,
              "required": true,
              "value_name": "TITLE"
            },
            {
              "flags": "--note",
              "help": "Initial note body read from FILE, or '-' for stdin",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings new <--title> [--note] [-h]"
        },
        {
          "about": "Show the note or generated summaries for a meeting, or edit the note",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "fmtr meetings note",
          "options": [
            {
              "default": "note",
              "flags": "--kind",
              "is_flag": false,
              "possible_values": [
                "note",
                "summary",
                "all"
              ],
              "required": false,
              "value_name": "KIND"
            },
            {
              "flags": "--set",
              "help": "Replace the note body with FILE, or '-' for stdin",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--append",
              "help": "Append FILE (or '-' for stdin) to the note body",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings note [--kind] [--set] [--append] [-h] <id>"
        },
        {
          "about": "Show the full speaker-labeled meeting transcript",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "fmtr meetings transcript",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings transcript [-h] <id>"
        },
        {
          "about": "Export a meeting to Markdown or JSON",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "fmtr meetings export",
          "options": [
            {
              "default": "markdown",
              "flags": "--format",
              "is_flag": false,
              "possible_values": [
                "markdown",
                "json"
              ],
              "required": false,
              "value_name": "FORMAT"
            },
            {
              "flags": "-o, --output",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--force",
              "help": "Replace an existing output file",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "fmtr meetings export [--format] [-o] [--force] [-h] <id>"
        }
      ],
      "synopsis": "fmtr meetings [-h] <command>"
    },
    {
      "about": "Import an audio file into a new meeting and print its id",
      "arguments": [
        {
          "help": "Audio file to import (wav, mp3, ogg, mp4, m4a, flac, webm, or aac)",
          "name": "FILE",
          "required": true
        }
      ],
      "name": "fmtr import",
      "options": [
        {
          "flags": "--title",
          "help": "Title for the new meeting; defaults to the file name",
          "is_flag": false,
          "required": false,
          "value_name": "TITLE"
        },
        {
          "flags": "--transcribe",
          "help": "Transcribe the audio with the configured on-device model after importing",
          "is_flag": true,
          "required": false
        },
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "fmtr import [--title] [--transcribe] [-h] <file>"
    },
    {
      "about": "Transcribe a meeting's audio with the configured on-device model",
      "arguments": [
        {
          "help": "Meeting id whose audio should be transcribed",
          "name": "ID",
          "required": true
        }
      ],
      "name": "fmtr transcribe",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "fmtr transcribe [-h] <id>"
    },
    {
      "about": "Run the read-only Free Meeting Transcriber MCP server over stdio",
      "name": "fmtr mcp",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "fmtr mcp [-h]"
    }
  ],
  "synopsis": "fmtr [--base] [--vault-path] [--json] [-h] [-V] <command>"
}
