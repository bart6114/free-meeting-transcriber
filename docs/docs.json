{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Free Meeting Transcriber",
  "colors": {
    "primary": "#f59e0b",
    "light": "#fbbf24",
    "dark": "#d97706"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart"]
