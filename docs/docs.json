          "meetings",
          "automatic-capture",
          "import-recordings",
          "notes",
          "customize-summaries",
          "languages"
        ]
      },
      {
        "group": "AI and privacy",
        "pages": ["ai-setup", "offline", "data-and-privacy"]
      },
      {
        "group": "CLI and agents",
        "pages": [
          "installation",
          "agents/overview",
          "agents/cli",
          "agents/mcp",
          "agents/skills"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/mcp",
          "reference/errors"
        ]
      },
      {
        "group": "Help",
        "pages": ["help", "troubleshooting"]
      }
